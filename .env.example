# Copy to .env.local and fill in. Never commit .env.local.
# Google OAuth 2.0 Web client ID (Google Cloud Console > APIs & Services > Credentials).
# Leave empty to run the tool in offline mode (local browser storage only).
VITE_GOOGLE_CLIENT_ID=
# Optional: base path when hosting under a sub-path (e.g. GitHub Pages "/CIVIL-Senawave/").
VITE_BASE_PATH=/
